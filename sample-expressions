and(
  not(
    or(
      equals(item()?['RequestStatus']?['Value'],'Completed'),
      equals(item()?['RequestStatus']?['Value'],'Cancelled'),
      equals(item()?['RequestStatus']?['Value'],'Closed'),
      equals(item()?['RequestStatus']?['Value'],'Rejected (Not SS)')
    )
  ),
  greaterOrEquals(
    ticks(
      parseDateTime(
        if(
          equals(
            length(
              split(
                coalesce(item()?['RequestedCompletionDate'],''),
                '/'
              )
            ),
            3
          ),
          item()?['RequestedCompletionDate'],
          '12/31/9999'
        ),
        'en-US'
      )
    ),
    ticks(startOfDay(utcNow()))
  ),
  lessOrEquals(
    ticks(
      parseDateTime(
        if(
          equals(
            length(
              split(
                coalesce(item()?['RequestedCompletionDate'],''),
                '/'
              )
            ),
            3
          ),
          item()?['RequestedCompletionDate'],
          '12/31/9999'
        ),
        'en-US'
      )
    ),
    ticks(addDays(startOfDay(utcNow()),3))
  )
)