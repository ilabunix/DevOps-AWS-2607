and(
  equals(
    length(
      split(
        coalesce(item()?['RequestedCompletionDate'],''),
        '/'
      )
    ),
    3
  ),
  isInt(
    first(
      split(
        coalesce(item()?['RequestedCompletionDate'],''),
        '/'
      )
    )
  ),
  isInt(
    first(
      skip(
        split(
          coalesce(item()?['RequestedCompletionDate'],''),
          '/'
        ),
        1
      )
    )
  ),
  isInt(
    last(
      split(
        coalesce(item()?['RequestedCompletionDate'],''),
        '/'
      )
    )
  )
)