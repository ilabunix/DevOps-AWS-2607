fields @timestamp, `log.level`, message, `error.type`, `error.message`
| filter @logStream like /-tg-dp\//
| filter @message like /easyIrdReconcileLoadJob|calcSettlementTiersJob|mergeSplitOrgsJob/
| filter @message like /Starting job:|Initializing job|Launching job|Stopping job|Job Failure for|Encountered an error executing step|Encountered an error saving batch meta data|Exception thrown when trying to launch job|Skip limit exceeded|rollback|roll back/
    or `log.level` in ["ALERT", "ERROR"]
| sort @timestamp desc
| limit 200