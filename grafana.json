fields @timestamp, message, `process.thread.name`, log.logger
| filter @logStream like /-tg-dp\//
| filter message like /(dasyRevenueStoreJob|ftaStoreJob|vpnStoreJob|fedMailStoreJob|nicBhcStoreJob|pieUserStoreJob|routerStoreJob|udyStoreJob|uimStoreJob)/
| filter message like /finished with status|Job exit status|Job Failure for|Launching job/
| sort @timestamp desc
| limit 200


