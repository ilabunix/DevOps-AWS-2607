fields @timestamp, `log.level`, message
| filter @logStream like /-tg-dp\//
| filter @message like /easyProfileAddressLoadJob|easyProfileAddressVerifyJob|easyIasLoad|easyIrdDailyLoadJob|easyIrdReconcileLoadJob|easyCompassDataLoadJob|eaBillingCalculationJob|calcSettlementTiersJob|mergeSplitOrgsJob/
| filter @message like /${job_name:regex}/
| filter @message like /Stopping job|ParallelLockoutListener|due to .* other executions|concurrent execution|optimistic lock/
| sort @timestamp desc
| limit 100