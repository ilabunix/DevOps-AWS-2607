fields @timestamp, message
| filter @logStream like /-tg-dp\//
| filter message like /finished with status: COMPLETED/
| parse message "Job * finished with status: *" as job, status
| filter job like /(dasyRevenueStoreJob|ftaStoreJob|vpnStoreJob|fedMailStoreJob|nicBhcStoreJob|pieUserStoreJob|routerStoreJob|udyStoreJob|uimStoreJob)/
| filter job like /${job_name:regex}/
| stats count() as value