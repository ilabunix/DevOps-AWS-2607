fields @timestamp, @message, @logStream
| filter @logStream like /-tg-dp\//
| filter @message like /(dasyRevenueStoreJob|ftaStoreJob|vpnStoreJob|fedMailStoreJob|nicBhcStoreJob|pieUserStoreJob|routerStoreJob|udyStoreJob|uimStoreJob)/
| filter @message like /Job Failure for|Encountered fatal error executing job|Exception thrown when trying to launch job/
| sort @timestamp desc
| limit 100

fields @timestamp, @message
