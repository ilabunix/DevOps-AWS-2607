    {
      "id": 2,
      "type": "stat",
      "title": "Jobs Completed",
      "datasource": {
        "type": "cloudwatch",
        "uid": "$datasource"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "cloudwatch",
            "uid": "$datasource"
          },
          "queryMode": "Logs",
          "region": "$region",
          "logGroups": [
            {
              "name": "$log_group"
            }
          ],
          "expression": "fields @timestamp, @message, message\n| filter @message like /${job_name:regex}/\n| filter @message like /Job exit status \\(COMPLETED\\)|COMPLETED|Successfully registered|Job completed|completed/\n| stats count() as value",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": []
        },
        "overrides": []
      }
